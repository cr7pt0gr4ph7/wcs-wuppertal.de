---
import { Picture } from "astro:assets";
import { type InferEntrySchema } from "astro:content";
import { Temporal } from "temporal-polyfill";
import { hyphenate } from "../utils/hyphenate.ts";
import { toImageProps } from "../utils/images";
import { parseImageObject } from "../utils/model";
import { getCalendarEntries, type EventType } from "../utils/content";

interface Props {
  merged?: boolean;
  tags?: string[][];
  types?: EventType[];
  showImages?: boolean;
  showSubtitles?: boolean;
}

const {
  merged = false,
  types,
  tags,
  showImages = true,
  showSubtitles = true,
} = Astro.props;

const entries = await getCalendarEntries({
  types,
  tags,
  since: Temporal.Now.zonedDateTimeISO().subtract({ days: 1 }),
});

const myShortDateFormatOpts: Intl.DateTimeFormatOptions = {
  month: "2-digit",
  day: "2-digit",
};

const myDateFormatOpts: Intl.DateTimeFormatOptions = {
  month: "2-digit",
  day: "2-digit",
  year: "numeric",
};

const myWeekdayFormatOpts: Intl.DateTimeFormatOptions = {
  weekday: "long",
};

const myTimeFormatOpts: Intl.DateTimeFormatOptions = {
  hour: "2-digit",
  minute: "2-digit",
};

const treatAsSingleDay = (
  date: Temporal.PlainDate | Temporal.PlainDateTime | Temporal.ZonedDateTime,
  endDate: Temporal.PlainDate | Temporal.PlainDateTime | Temporal.ZonedDateTime,
) => {
  const start: Temporal.PlainDateTime =
    (
      date as Temporal.PlainDate | Temporal.ZonedDateTime
    )?.toPlainDateTime?.() ?? date;
  const end: Temporal.PlainDateTime =
    (
      endDate as Temporal.PlainDate | Temporal.ZonedDateTime
    )?.toPlainDateTime?.() ?? endDate;

  return (
    Temporal.PlainDateTime.compare(
      start.add(Temporal.Duration.from({ hours: 14 })),
      end,
    ) >= 0
  );
};

const isSameYear = (
  date: Temporal.PlainDate | Temporal.PlainDateTime | Temporal.ZonedDateTime,
  endDate: Temporal.PlainDate | Temporal.PlainDateTime | Temporal.ZonedDateTime,
) => {
  return date.year === endDate.year;
};

const formatDate = (
  date: Temporal.PlainDate | Temporal.PlainDateTime | Temporal.ZonedDateTime,
  endDate?:
    Temporal.PlainDate | Temporal.PlainDateTime | Temporal.ZonedDateTime,
) => {
  if (endDate === undefined || treatAsSingleDay(date, endDate)) {
    return date.toLocaleString("de-DE", myDateFormatOpts);
  } else {
    return (
      date.toLocaleString(
        "de-DE",
        isSameYear(date, endDate) ? myShortDateFormatOpts : myDateFormatOpts,
      ) +
      " bis " +
      endDate.toLocaleString("de-DE", myDateFormatOpts)
    );
  }
};

const formatWeekdayAndTime = (
  date: Temporal.PlainDateTime | Temporal.ZonedDateTime,
) => {
  return (
    date.toLocaleString("de-DE", myDateFormatOpts) +
    " – " +
    date.toLocaleString("de-DE", myDateFormatOpts)
  );
};

const formatDateTime = (
  date: Temporal.PlainDateTime | Temporal.ZonedDateTime,
  endDate?: Temporal.PlainDateTime | Temporal.ZonedDateTime,
) => {
  if (endDate === undefined || treatAsSingleDay(date, endDate)) {
    return (
      date.toLocaleString("de-DE", myDateFormatOpts) +
      " " +
      date.toLocaleString("de-DE", myTimeFormatOpts) +
      " Uhr"
    );
  } else {
    return (
      date.toLocaleString(
        "de-DE",
        isSameYear(date, endDate) ? myShortDateFormatOpts : myDateFormatOpts,
      ) +
      " bis " +
      endDate.toLocaleString("de-DE", myDateFormatOpts)
    );
  }
};

interface BaseRowData {
  image?: string | { src: string; alt?: string };
  calendar?: {
    title?: string;
    subtitle?: string;
  };
  title: string;
  subtitle?: string;
  date: Temporal.ZonedDateTime;
  endDate?: Temporal.ZonedDateTime;
  dates?: Temporal.ZonedDateTime[];
  location: string;
  url?: string;
  links?: {
    registration?: string;
  };
  type: InferEntrySchema<"calendar" | "events">["type"];
}

interface RowData extends BaseRowData {
  children?: BaseRowData[];
  groups?: {
    title: string;
    children?: BaseRowData[];
  }[];
  single_date?: boolean;
}

const sortByDate = <T extends BaseRowData>(entries: T[]) => {
  return entries.toSorted((a, b) =>
    Temporal.ZonedDateTime.compare(a.date, b.date),
  );
};

type Columns = Record<string, { format: (entry: RowData) => any }>;
---

{
  (() => {
    const formatDates = (
      dates: (Temporal.PlainDateTime | Temporal.ZonedDateTime)[],
    ) => {
      if (dates.length < 1) {
        return null;
      }
      return (
        <>
          {formatWeekdayAndTime(dates[0])}
          {dates.map((date) => (
            <>
              <br />
              {"ab " + formatDate(date)}
            </>
          ))}
        </>
      );
    };

    const columns = {
      name: {
        format: (entry: RowData) => {
          const title = entry.calendar?.title ?? entry.title;
          const subtitle = entry.calendar?.subtitle ?? entry.subtitle;
          let imageProps = toImageProps(parseImageObject(entry.image));
          return (
            <div class="td name-and-image">
              <div class="td image">
                {showImages && imageProps ? (
                  <Picture class="teaser-image" {...imageProps} />
                ) : null}
              </div>
              <div class="td name">
                {subtitle && showSubtitles ? (
                  <span class="title-box">
                    <span class="title">{hyphenate(title)}</span>{" "}
                    <span class="subtitle">{hyphenate(subtitle)}</span>
                  </span>
                ) : (
                  <span class="title-box">{hyphenate(title)}</span>
                )}
              </div>
            </div>
          );
        },
      },
      dates: {
        format: (entry: RowData) =>
          entry.single_date ? (
            <div class="td dates">
              {entry.dates
                ? formatDates(entry.dates)
                : formatDate(entry.date, entry.endDate)}{" "}
              <span class="additional-dates">{"+ mehr Infos"}</span>
            </div>
          ) : !entry.children && !entry.groups ? (
            <div class="td dates">
              {entry.dates
                ? formatDates(entry.dates)
                : formatDateTime(entry.date, entry.endDate)}
            </div>
          ) : (
            <div class="td dates">
              {formatDate(entry.date, entry.endDate)}{" "}
              <span class="additional-dates">
                {"+ "}
                <span>
                  {(entry.children?.length ?? 0) +
                    (entry.groups?.reduce(
                      (acc, item) => acc + (item.children?.length ?? 0),
                      0,
                    ) ?? 0) -
                    1}
                  <span class="if-large-viewport">
                    {entry.children?.length === 2
                      ? entry.type?.regular_course
                        ? " weiterer Starttermin"
                        : " weiterer Termin"
                      : entry.type?.regular_course
                        ? " weitere Starttermine"
                        : " weitere Termine"}
                  </span>
                </span>
              </span>
            </div>
          ),
      },
      location: {
        format: (entry: RowData) => (
          <div class="td location">{hyphenate(entry.location)}</div>
        ),
      },
      link: {
        format: (entry: RowData) => {
          const registrationNeeded =
            types?.some(
              (eventType) => entry.type[eventType]?.requires_registration,
            ) ?? false;

          const workshopRegistrationNeeded =
            !registrationNeeded &&
            entry.type["workshop"]?.requires_registration;

          const forceMoreInfos =
            types?.some((eventType) => entry.type[eventType]?.more_infos) ??
            false;

          const additionalText =
            types
              ?.map((eventType) => entry.type[eventType]?.additional_text)
              .filter((text) => text)
              .at(0) ?? "";

          const showMoreInfos =
            entry.url &&
            (forceMoreInfos ||
              !registrationNeeded ||
              (entry.links?.registration &&
                entry.links.registration !== entry.url));

          const registrationUrl = entry.links?.registration ?? entry.url;
          const showRegistrationLink =
            registrationUrl &&
            (registrationNeeded ||
              (entry.url &&
                entry.links?.registration &&
                entry.links?.registration !== entry.url));

          let children = [];
          if (showMoreInfos && entry.url) {
            children.push(<a href={entry.url}>Mehr Infos</a>);
          }
          if (registrationNeeded && registrationUrl) {
            if (children.length > 0) {
              children.push(" | ");
            }
            children.push(<a href={registrationUrl}>Anmelden</a>);
          }
          if (registrationNeeded && !registrationUrl) {
            if (children.length > 0) {
              children.push(" | ");
            }
            children.push(<span>Anmeldung erforderlich</span>);
          } else {
            if (children.length > 0) {
              children.push(" | ");
            }
            if (registrationNeeded) {
              children.push(<span>Anmeldung erforderlich</span>);
            } else if (
              workshopRegistrationNeeded &&
              types?.find((t) => t === "party")
            ) {
              children.push(<span>Workshop: Anmeldung erforderlich</span>);

              children.push(" | ");
              children.push(<span>Party: Keine Anmeldung erforderlich</span>);
            } else {
              children.push(<span>Keine Anmeldung erforderlich</span>);
            }
          }
          if (additionalText) {
            if (children.length > 0) {
              children.push(" | ");
            }
            children.push(<span>{additionalText}</span>);
          }

          return <div class="td link">{children}</div>;
        },
      },
    } satisfies Columns;

    const formatRowContent = (entry: RowData) =>
      merged ? (
        <>
          {columns.name.format(entry)}
          <div class="td date-and-location">
            {columns.dates.format(entry)}
            {columns.location.format(entry)}
          </div>
          {columns.link.format(entry)}
        </>
      ) : (
        <>
          {columns.name.format(entry)}
          {columns.dates.format(entry)}
          {columns.location.format(entry)}
          {columns.link.format(entry)}
        </>
      );

    const formatRowClass = (prefix: string, entry: RowData) => {
      return (
        prefix +
        " " +
        Object.keys(entry.type ?? {})
          .map((type) => "event-type-" + type.replaceAll("_", "-"))
          .join(" ")
      );
    };

    return (
      <div
        class={
          (merged ? "table merged" : "table") +
          " o-expander-border o-inline-column-titles"
        }
      >
        <div class="thead" />
        <div class="tbody">
          {sortByDate(entries.map((entry) => entry.data)).map((entry) => {
            if (!(entry as any)?.children && !(entry as any)?.groups) {
              return (
                <div class={formatRowClass("tr primary", entry)}>
                  {formatRowContent(entry)}
                </div>
              );
            } else {
              return (
                <div class={formatRowClass("tr-parent", entry)}>
                  <details>
                    <summary class={formatRowClass("tr primary", entry)}>
                      {formatRowContent(entry)}
                    </summary>
                  </details>
                  <div class="expander">
                    <div class="sub-table">
                      {sortByDate((entry as any)?.children ?? []).map(
                        (child) => (
                          <div class={formatRowClass("tr", entry)}>
                            {formatRowContent(child)}
                          </div>
                        ),
                      )}
                      {((entry as any)?.groups ?? []).map((group: any) => {
                        return (
                          <div class="group">
                            <div class="group-header tr">{group.title}</div>
                            {sortByDate(group.children ?? []).map((child) => (
                              <div class={formatRowClass("tr", child)}>
                                {formatRowContent(child)}
                              </div>
                            ))}
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              );
            }
          })}
        </div>
      </div>
    );
  })()
}

<style>
  /* COMPONENT: ROUNDED EDGES FOR THE WHOLE TABLE */
  .table {
    border-radius: var(--table-border-radius);
  }

  .table > .tbody > .tr-parent:first-child .tr.primary,
  .table > .tbody > .tr.primary:first-child {
    border-top-left-radius: var(--table-border-radius);
    border-top-right-radius: var(--table-border-radius);
  }

  .table > .tbody > .tr-parent:last-child .tr.primary,
  .table > .tbody > .tr.primary:last-child {
    border-bottom-left-radius: var(--table-border-radius);
    border-bottom-right-radius: var(--table-border-radius);
  }
</style>

<style>
  /* COMPONENT: "ADDITIONAL DATES" PILL */
  .additional-dates {
    font-weight: var(--pill-font-weight);
    font-size: var(--pill-font-size);
    line-height: var(--pill-line-height);
    /* -- */
    padding-top: calc(0.3125 * var(--pill-font-size));
    padding-bottom: calc(0.25 * var(--pill-font-size));
    padding-left: calc(0.75 * var(--pill-font-size));
    padding-right: calc(1 * var(--pill-font-size));
    border-radius: calc(1.5 * var(--pill-font-size));
    /* -- */
    position: relative;
    bottom: calc(2 / 16 * var(--pill-font-size));
  }

  .additional-dates {
    text-wrap: nowrap;
    /* word-break: break-all; */ /* "word-wrap: break-all" causes line breaks at unintended positions in Firefox 136 */
    /* -- */
    background-color: var(--pill-background);
    color: var(--pill-color);
  }

  .tr:hover .additional-dates {
    background-color: var(--pill-background-hover);
    color: var(--pill-color-hover);
  }
</style>

<style>
  /* COMPONENT: LINKS */
  .table {
    --table-color-current-normal: var(--table-color);
    --table-color-current-highlight: var(--table-color-highlight);
  }

  .table a,
  .table a:active,
  .table a:visited,
  .table a:target {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--table-color-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .link span {
    font-style: italic;
    color: var(--secondary-subdued);
  }

  .tr:hover link span {
    color: #808080;
  }

  .table a:hover,
  .table a:focus {
    text-decoration: underline;
    text-decoration-color: var(--table-color);
    text-decoration-thickness: auto;
    text-underline-offset: auto;
  }

  .tr {
    background-color: var(--table-background);
    color: var(--table-color);
    border: var(--table-border);

    --table-color-current-normal: var(--table-color);
    --table-color-current-highlight: var(--table-color-highlight);
  }

  .tr:hover {
    background-color: var(--table-background-hover);
    color: var(--table-color-hover);
    border: var(--table-border-hover);

    --table-color-current-normal: var(--table-color-hover);
    --table-color-current-highlight: var(--table-color-highlight-hover);
  }

  .tr .link a {
    color: var(--table-color-current-normal);
  }

  .tr .link a:hover {
    color: var(--table-color-current-highlight);
  }
</style>

<style>
  /* COMPONENT: VIEWPORT-DEPENDENT VISIBILITY */
  .if-small-viewport {
    display: inline;
  }

  .if-large-viewport {
    display: none;
  }

  @media (min-width: 1120px) {
    .if-small-viewport {
      display: none;
    }

    .if-large-viewport {
      display: inline;
    }
  }
</style>

<style>
  /* COMPONENT: EXPANDER */
  details:not([open]) + .expander {
    display: none;
  }
  .tr-parent {
    cursor: pointer;
  }

  /* LAYOUT: EXPANDER w/ SPACE AFTER OPEN EXPANDER */
  details + .expander {
    /* TODO: Can we get rid of this? */
    margin-bottom: var(--expander-open-gap);
  }
</style>

<style>
  /* LAYOUT: EXPANDER - BORDER */
  .table {
    --sub-table-marker-width: 0px;
  }

  .o-expander-border.table {
    --sub-table-marker-width: var(--expander-border-marker-width);
  }

  .o-expander-border details + .expander .tr {
    border-left: var(--sub-table-marker-width) solid
      var(--sub-table-marker-color);
  }
</style>

<style>
  /* LAYOUT: EXPANDER - CUSTOM MARKER */
  .table details summary {
    list-style: none;
  }
  .table details summary::marker,
  .table details summary::-webkit-details-marker {
    content: none;
  }
  .table details summary::before {
    font-size: var(--expander-font-size);
    content: "\0025BA";
  }
  .table details[open] summary::before {
    content: "\0025BC";
  }
</style>

<style>
  /* LAYOUT: EXPANDER OUTSIDE (LAYOUT: TABLE) */
  .table details summary {
    padding-left: var(--expander-column-width);
    position: relative;
  }
  .table details summary::before {
    position: absolute;
    width: 0;
    left: var(--expander-column-padding-left);
    display: block;
  }
  .table details + .expander > .sub-table > .tr {
    padding-left: var(--expander-column-width);
  }

  /* LAYOUT: EXPANDER - CUSTOM BORDER - ADAPTIONS */
  .table details + .expander > .sub-table > .tr {
    padding-left: calc(
      var(--expander-column-width) - var(--sub-table-marker-width)
    );
  }

  @media (min-width: 900px) {
    /* LAYOUT: EXPANDER INSIDE (LAYOUT: TABLE) - ADAPTIONS */
    .table details summary {
      padding-left: 0;
      position: static;
    }
    .table details summary::before {
      position: static;
      left: auto;
    }
  }
</style>

<style>
  /* LAYOUT: EXPANDER INSIDE (LAYOUT: TABLE) */
  @media (min-width: 900px) {
    /* LAYOUT: TABLE - ADAPTIONS */
    .table details summary::before {
      padding-left: var(--expander-column-padding-left);
      grid-column: expander;
    }
  }
</style>

<style>
  /* LAYOUT: GROUPS w/ NO GROUP HEADERS */
  .group-header {
    display: none !important;
  }
</style>

<style>
  /* Variables */
  .table {
    --pill-font-size: 1rem;
    --pill-font-weight: 400;
    --pill-line-height: var(--table-line-height);
    /* -- */
    --expander-font-size: 1em;
    --expander-column-width: 2rem;
    --expander-column-padding-left: 0.25rem;
    --expander-open-gap: 0.25rem;
    --expander-border-marker-width: 0.4rem;
    /* -- */
  }

  /* Base style */
  .table {
    font-size: var(--table-font-size);
    line-height: var(--table-line-height);
    font-weight: var(--table-font-weight);
  }

  .sub-table {
    font-weight: var(--sub-table-font-weight);
    /* font-size: 1.25rem; */
  }

  /* Groups */
  .group-header {
    font-weight: 400;
    font-size: var(--table-font-size);
    line-height: 1;
    color: var(--primary-subdued);
  }

  .group .tr {
    font-size: 1.4rem;
  }

  /** Links */
  .table a,
  .table a:active,
  .table a:visited,
  .table a:target {
    font-weight: 700;
  }

  .link span {
    font-weight: 300;
    font-size: 1rem;
    line-height: var(--table-line-height);
  }

  /* Columns */
  .description {
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.5;
  }
</style>

<style>
  /* LAYOUT: SPACING */
  .table .td {
    padding-bottom: var(--table-line-gap);
  }
</style>

<style>
  /** LAYOUT: INLINE COLUMN TITLES */
  .o-inline-column-titles .td::before {
    padding-right: 0.25em;
  }

  .o-inline-column-titles .td::before {
    font-weight: 700;
  }
</style>

<style>
  /* LAYOUT: BLOCK COLUMN TITLES - LARGE SPACING */
  .o-block-column-titles .td::before {
    display: block;
    font-weight: 800;
    font-size: 16px;
    line-height: 50px;
  }

  /* LAYOUT: BLOCK COLUMN TITLES - INDENT */
  .o-block-column-titles .td::before {
    margin-left: calc(-1 * var(--indent));
  }
</style>

<style>
  /* LAYOUT: TABLE */
  @media (min-width: 900px) {
    .table {
      display: grid;
      grid-template-columns:
        [start expander expander-start] var(--expander-column-width)
        [name expander-end name-start] 18fr
        [datetime datetime-start name-end] 11fr
        [location location-start datetime-end] 13fr
        [link link-start location-end] 8fr
        [end link-end];
    }

    .name,
    .name-and-image,
    .image {
      grid-column: name;
    }
    .dates {
      grid-column: datetime;
    }
    .date {
      grid-column: datetime;
    }
    .time,
    .times {
      grid-column: datetime;
    }
    .location {
      grid-column: location;
    }
    .link {
      grid-column: link;
      margin-top: 0;
    }
    .description {
      grid-column: start / end;
    }

    .tbody,
    .thead,
    .tr-parent,
    .tr,
    .expander,
    .extended,
    .sub-table,
    .group,
    .group-header,
    .table details,
    .table details summary {
      grid-column: start / end;
      display: grid;
      grid-template-columns: subgrid;
    }
  }
</style>

<style>
  /* LAYOUT: COMPACT TABLE */
  @media (min-width: 900px) {
    .merged.table,
    .merged.table details summary.tr {
      display: grid;
      grid-template-columns:
        [start expander expander-end] var(--expander-column-width)
        [name name-start expander-end] 27fr
        [datetime datetime-start name-end location location-start] 15fr
        [link link-start datetime-end location-end] 8fr
        [end link-end];
    }

    .merged.table .name,
    .merged.table .description {
      grid-row-end: span 2;
    }
  }
</style>

<style>
  /* COMPONENT/LAYOUT: GROUPS - HIGHLIGHT GROUP HEADERS */
  .group .tr .name,
  .group .tr .name-and-image,
  .group .tr .image {
    font-weight: 350;
  }

  .group .group-header + .tr .name,
  .group .group-header + .tr .name-and-image,
  .group .group-header + .tr .image {
    font-weight: 500;
  }
</style>

<style>
  /* COMPONENT/LAYOUT: COLUMN TITLES - HIGHLIGHT MAIN COLUMN TITLE */
  .name {
    font-weight: 450;
    color: var(--table-color-current-highlight);
  }

  .name .title {
    font-weight: 500;
    color: var(--table-color-current-highlight);
  }

  .name .subtitle {
    font-weight: 400;
    color: var(--table-color-current-normal);
  }

  .sub-table .name,
  .sub-table .name .title,
  .sub-table .name .subtitle {
    font-weight: 300;
    color: var(--table-color-current-normal);
  }

  @media (min-width: 900px) {
    .sub-table .name {
      font-weight: 400;
      color: var(--table-color-current-current);
    }

    .sub-table .name .title {
      font-weight: 450;
      color: var(--table-color-current-highlight);
    }

    .sub-table .name .subtitle {
      font-weight: 350;
      color: var(--table-color-current-normal);
    }
  }
</style>

<style>
  /** COMPONENT/LAYOUT: GROUPS - LARGE SPACING */
  .group-header {
    padding-top: var(--table-group-header-padding);
    padding-bottom: var(--table-group-header-padding);
  }

  .group .tr {
    padding-top: var(--table-group-row-padding);
    padding-bottom: var(--table-group-row-padding);
  }

  .group {
    margin-top: var(--table-group-margin-top);
    margin-bottom: var(--table-group-margin-bottom);
  }

  /* LAYOUT: SPACING */
  .table {
    margin-bottom: var(--table-margin-bottom);
    margin-top: calc(-1 * var(--table-row-gap));
  }

  .tr {
    margin-top: var(--table-row-gap);
    padding-top: var(--table-row-padding);
    padding-bottom: var(--table-row-padding);
  }

  .tr {
    /* TODO: Can we get rid of this? */
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* COMPONENT/LAYOUT: LINK - SPACING */
  .link {
    margin-top: 0.5rem;
  }
</style>

