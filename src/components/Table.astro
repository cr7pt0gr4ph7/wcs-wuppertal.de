<style>
  /* LAYOUT: TABLE w/ LEFT PADDING FOR CELLS */
  .name,
  .date,
  .dates,
  .time,
  .times,
  .location,
  .link,
  .description,
  *[data-column-name] {
    --indent: 0.5rem;
    margin-left: var(--indent);
  }
</style>

<style>
  /* COMPONENT: COLUMN TITLES */
  *[data-column-name]::before {
    content: attr(data-column-name);
  }

  .name::before {
    content: "Was?";
  }
  .date::before,
  .dates::before {
    content: "Wann?";
  }
  .time::before,
  .times::before {
    /* content: ""; */
  }
  .location::before {
    content: "Wo?";
  }
  .link::before {
    /* content: ""; */
  }
  .description::before {
    content: "Beschreibung";
  }

  @media (min-width: 900px) {
    /* LAYOUT: TABLE - ADAPTIONS */
    .td::before {
      padding-right: 0;
      content: none !important;
    }
  }
</style>
