---
import { Icon } from "astro-icon/components";
import "../styles/section.css";
import Table from "../components/Table.astro";
---

<section>
  <a name="parties"></a>
  <a name="workshops"></a>
  <a name="events"></a>
  <h2>
    <a class="anchor" href="#parties" title="#parties"
      ><span class="strong">Parties</span>
      <span class="subdued">&amp;</span>
      <span class="strong">Events</span>
    </a>
  </h2>
  <form class="event-filter">
    <div class="event-filter-group">
      <span class="filter-icon">
        <Icon size="2em" name="material-symbols:filter-alt" />
      </span>
      <div class="event-filter-scroll">
        <div class="event-filter-group-items">
          <label
            class="event-filter-option"
            style="min-width: calc(29/16*1rem*var(--factor)/1.25)"
          >
            <input type="radio" name="type" value="all" checked />
            <span>Alle</span>
          </label>
          <label
            class="event-filter-option"
            style="min-width: calc(173/16*1rem*var(--factor)/1.25)"
          >
            <input type="radio" name="type" value="workshop" />
            <span>Workshops &amp; Intensives</span>
          </label>
          <label
            class="event-filter-option"
            style="min-width: calc(151/16*1rem*var(--factor)/1.25)"
          >
            <input type="radio" name="type" value="beginner_workshop" />
            <span>Einsteigerworkshops</span>
          </label>
          <label
            class="event-filter-option"
            style="min-width: calc(52/16*1rem*var(--factor)/1.25)"
          >
            <input type="radio" name="type" value="party" />
            <span>Parties</span>
          </label>
          <label
            class="event-filter-option"
            style="min-width: calc(65/16*1rem*var(--factor)/1.25)"
          >
            <input type="radio" name="type" value="festival" />
            <span>Festivals</span>
          </label>
        </div>
      </div>
    </div>
  </form>
  <Table
    merged={true}
    types={["workshop", "beginner_workshop", "party", "festival"]}
  />
  <p class="small subdued event-filter-no-entries">
    In der von Dir gewählten Kategorie gibt es aktuell keine anstehenden
    Veranstaltungen.
  </p>
  <p>
    Weitere Parties &amp; Workshops in ganz NRW findet ihr bei <a
      href="https://westiecommunity.de/"
      target="_blank">Westie Community NRW</a
    >!
  </p>
</section>
<script>
  import { ScrollBooster } from "scrollbooster";

  const viewport = document.querySelector(".event-filter-scroll") as HTMLElement;
  viewport.classList.add("js-scroll");
  const sb = new ScrollBooster({
    viewport,
    direction: "horizontal",
    inputsFocus: true,
    wheel: "horizontal",
  });
</script>
<style>
  .filter-icon {
    color: #606060;
    align-self: center;
  }

  .event-filter-group {
    display: flex;
    flex-wrap: nowrap;
    margin-bottom: 2rem;
    font-size: 1.125rem;
    --factor: 1.125;
  }

  .event-filter-group-items {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .event-filter-option {
    box-sizing: content-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: 2px solid #606060;
    border-radius: calc(20px + 1em);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .event-filter-group-items {
    flex-wrap: nowrap;
  }
  .event-filter-scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .event-filter-scroll.js-scroll {
    overflow: hidden;
  }
  .event-filter-scroll.js-scroll .event-filter-group-items {
    display: flex;
    width: max-content;
    overflow: hidden;
  }

  .event-filter-option {
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .event-filter-group {
      font-size: 1rem;
      --factor: 1;
    }

    .event-filter-option {
      padding: 8px 20px;
      border-radius: calc(10px + 1em);
    }

    .filter-icon {
      height: calc(10px + 1em);
    }
  }

  .event-filter-option input[type="radio"] {
    display: none;
  }

  .event-filter-option input[type="radio"]:checked + span {
    font-weight: bold;
  }

  .event-filter-option:has(input[type="radio"]:hover) {
    border-color: #aaa;
  }

  .event-filter-option:has(input[type="radio"]:checked) {
    border-color: #eee;
    /* border-color: #007bff; */
    /* background-color: #e7f1ff; */
    /* color: #007bff; */
  }
</style>
